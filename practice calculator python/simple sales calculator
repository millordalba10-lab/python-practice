import tkinter as tk
from tkinter import messagebox

# =========================
# MAIN WINDOW
# =========================
window = tk.Tk()
window.title("Sales Calculator")
window.geometry("450x600")
window.resizable(False, False)
window.configure(bg="#121212")


# =========================
# FUNCTIONS
# =========================
def calculate():
    try:
        price = float(price_entry.get())
        quantity = int(quantity_entry.get())

        if price < 0 or quantity <= 0:
            messagebox.showerror(
                "Invalid Input",
                "Please enter valid price and quantity."
            )
            return

        total = price * quantity

        result_label.config(
            text=f"₱{total:,.2f}"
        )

        details_label.config(
            text=f"₱{price:,.2f} × {quantity} item(s)"
        )

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter numbers only."
        )


def clear():
    price_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)

    result_label.config(
        text="₱0.00"
    )

    details_label.config(
        text="Enter price and quantity"
    )


# =========================
# HEADER
# =========================
header = tk.Frame(
    window,
    bg="#1E1E1E",
    height=100
)
header.pack(fill="x")

tk.Label(
    header,
    text="SALES CALCULATOR",
    font=("Arial", 25, "bold"),
    fg="white",
    bg="#1E1E1E"
).pack(pady=(25, 5))

tk.Label(
    header,
    text="Calculate your total sales easily",
    font=("Arial", 11),
    fg="#AAAAAA",
    bg="#1E1E1E"
).pack()


# =========================
# INPUT SECTION
# =========================
input_frame = tk.Frame(
    window,
    bg="#1E1E1E"
)
input_frame.pack(
    fill="x",
    padx=25,
    pady=20
)

# Price
tk.Label(
    input_frame,
    text="PRODUCT PRICE",
    font=("Arial", 11, "bold"),
    fg="#AAAAAA",
    bg="#1E1E1E"
).pack(anchor="w")

price_entry = tk.Entry(
    input_frame,
    font=("Arial", 18),
    bg="#2A2A2A",
    fg="white",
    insertbackground="white",
    relief="flat",
    justify="center"
)
price_entry.pack(
    fill="x",
    pady=(5, 15),
    ipady=10
)

# Quantity
tk.Label(
    input_frame,
    text="QUANTITY SOLD",
    font=("Arial", 11, "bold"),
    fg="#AAAAAA",
    bg="#1E1E1E"
).pack(anchor="w")

quantity_entry = tk.Entry(
    input_frame,
    font=("Arial", 18),
    bg="#2A2A2A",
    fg="white",
    insertbackground="white",
    relief="flat",
    justify="center"
)
quantity_entry.pack(
    fill="x",
    pady=(5, 5),
    ipady=10
)


# =========================
# BUTTONS
# =========================
button_frame = tk.Frame(
    window,
    bg="#121212"
)
button_frame.pack(
    fill="x",
    padx=25,
    pady=15
)

calculate_button = tk.Button(
    button_frame,
    text="CALCULATE",
    font=("Arial", 13, "bold"),
    bg="#4CAF50",
    fg="white",
    activebackground="#45A049",
    activeforeground="white",
    relief="flat",
    cursor="hand2",
    command=calculate
)
calculate_button.pack(
    side="left",
    expand=True,
    fill="x",
    padx=(0, 5),
    ipady=10
)

clear_button = tk.Button(
    button_frame,
    text="CLEAR",
    font=("Arial", 13, "bold"),
    bg="#333333",
    fg="white",
    activebackground="#444444",
    activeforeground="white",
    relief="flat",
    cursor="hand2",
    command=clear
)
clear_button.pack(
    side="right",
    expand=True,
    fill="x",
    padx=(5, 0),
    ipady=10
)


# =========================
# OUTPUT CARD
# =========================
output_frame = tk.Frame(
    window,
    bg="#1E1E1E"
)
output_frame.pack(
    fill="x",
    padx=25,
    pady=15
)

tk.Label(
    output_frame,
    text="TOTAL SALES",
    font=("Arial", 12, "bold"),
    fg="#AAAAAA",
    bg="#1E1E1E"
).pack(pady=(20, 5))

result_label = tk.Label(
    output_frame,
    text="₱0.00",
    font=("Arial", 34, "bold"),
    fg="#4CAF50",
    bg="#1E1E1E"
)
result_label.pack(pady=5)

details_label = tk.Label(
    output_frame,
    text="Enter price and quantity",
    font=("Arial", 11),
    fg="#888888",
    bg="#1E1E1E"
)
details_label.pack(pady=(0, 20))


# =========================
# FOOTER
# =========================
tk.Label(
    window,
    text="Simple • Fast • Easy",
    font=("Arial", 10),
    fg="#666666",
    bg="#121212"
).pack(pady=10)


# =========================
# START PROGRAM
# =========================
window.mainloop()